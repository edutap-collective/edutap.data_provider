# Copy to `.env` and adjust. `.env` is git-ignored; never commit a real token.
#
# The schema is applied by `edutap-dbdef` with a privileged database user, not by
# this service — it creates no table and writes no row. The user below therefore
# only needs SELECT on `person_view` and `pass_state`.

EDUTAP_DATA_PROVIDER_DATABASE_URL=postgresql+asyncpg://data_provider:data_provider@localhost:5432/data_provider
EDUTAP_DATA_PROVIDER_CONFIG_PATH=views.example.yaml
EDUTAP_DATA_PROVIDER_API_TOKEN=dev-token
EDUTAP_DATA_PROVIDER_ECHO_SQL=false
